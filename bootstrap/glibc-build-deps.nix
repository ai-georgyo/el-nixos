# Libraries/headers the glibc SRPM needs at build time that the stage0 root
# does not have, as one FHS tree (headers in usr/include, shared libraries in
# usr/lib64).  Copied into a glibc-specific stage0 root by packages/glibc.nix.
# See docs/glibc.md ("Buildroot") for the provenance of every item.
#
#   from nixpkgs (bootstrap only; they are linked by soname only, nothing of
#   them is copied into a shipped file except the headers compiled into
#   memusagestat/makedb):
#     gd + libpng + zlib  memusagestat (glibc-utils); configure's LIBGD probe
#     libselinux          makedb (nss_db); have-selinux
#     audit, libcap       configure probes inside the selinux branch (nscd /
#                         pt_chown only, neither is built)
#   from Rocky's systemtap SRPM source (no build needed):
#     sys/sdt.h, sys/sdt-config.h   --enable-systemtap (hard requirement)
#
# The nixpkgs .so files keep their RUNPATH into /nix/store (visible in stage0
# chroots), so ld finds their own dependencies at link time.  They are linked
# against the stage0 glibc 2.39 there, so the build FAILS if any library in
# their runtime closure references a GLIBC_2.40+ symbol version (re-checked
# on every nixpkgs bump, because this derivation is rebuilt then).
{ pkgs
, systemtapSrpm   # unpacked systemtap SRPM (lib.unpackSrpm "systemtap")
}:
let
  inherit (pkgs) lib;
  libs = with pkgs; [ gd libpng zlib libselinux audit libcap ];
  closure = pkgs.closureInfo { rootPaths = map lib.getLib libs; };
  stapVersion = systemtapSrpm.lockEntry.version;
  maxGlibc = "2.39"; # the stage0 glibc
in
pkgs.runCommand "stage0-glibc-build-deps"
{
  nativeBuildInputs = [ pkgs.binutils-unwrapped pkgs.gnutar pkgs.gzip ];
  passthru = { inherit libs; };
} ''
  set -euo pipefail
  mkdir -p $out/usr/include/sys $out/usr/lib64

  # --- nixpkgs libraries: headers + shared objects (no .la/.a) ----------------
  ${lib.concatMapStrings (p: ''
    echo "== ${p.name}: ${lib.getDev p} ${lib.getLib p}"
    if [ -d ${lib.getDev p}/include ]; then
      # never shadow a stage0 glibc header (or another library's)
      (cd ${lib.getDev p}/include && find . -type f -o -type l) | while read -r h; do
        if [ -e "$out/usr/include/$h" ]; then echo "header conflict: $h" >&2; exit 1; fi
      done
      cp -a --no-preserve=ownership,mode ${lib.getDev p}/include/. $out/usr/include/
    fi
    for f in ${lib.getLib p}/lib/*.so*; do
      cp -a --no-preserve=ownership,mode "$f" $out/usr/lib64/
    done
  '') libs}
  chmod -R u+w $out

  # --- systemtap-sdt-devel headers from Rocky's systemtap-${stapVersion} source --
  # (the SRPM applies no patches; sdt-config.h is generated by configure with
  # the two assembler capabilities binutils 2.41 has -- same bytes as the
  # official systemtap-sdt-devel-${stapVersion} header)
  tar -xzf ${systemtapSrpm}/systemtap-${stapVersion}.tar.gz -C $TMPDIR systemtap-${stapVersion}/includes/sys
  install -m 0644 $TMPDIR/systemtap-${stapVersion}/includes/sys/sdt.h $out/usr/include/sys/sdt.h
  sed -e 's|@configure_input@|includes/sys/sdt-config.h.  Generated from sdt-config.h.in by configure.|' \
      -e 's|@support_section_question@|1|' -e 's|@support_section_retain@|1|' \
      $TMPDIR/systemtap-${stapVersion}/includes/sys/sdt-config.h.in > $out/usr/include/sys/sdt-config.h
  chmod 0644 $out/usr/include/sys/sdt-config.h
  ! grep -q @ $out/usr/include/sys/sdt-config.h

  # --- symbol-version check over the whole runtime closure --------------------
  echo "checking that no library in the closure needs glibc > ${maxGlibc}"
  bad=0
  while read -r p; do
    case $p in *-glibc-[0-9]*) continue ;; esac   # nixpkgs glibc itself
    [ -d "$p/lib" ] || continue
    while IFS= read -r -d "" f; do
      head -c4 "$f" | grep -q ELF || continue
      v=$(objdump -T "$f" 2>/dev/null | grep -F '*UND*' | grep -oE 'GLIBC_2\.[0-9]+' | sort -uV | tail -n1 || true)
      [ -n "$v" ] || continue
      if [ "$(printf '%s\n%s\n' "GLIBC_${maxGlibc}" "$v" | sort -V | tail -n1)" != "GLIBC_${maxGlibc}" ]; then
        echo "  $f needs $v" >&2; bad=1
      fi
      echo "$v $f" >> $TMPDIR/versions
    done < <(find "$p/lib" -name '*.so*' -type f -print0)
  done < ${closure}/store-paths
  [ $bad = 0 ] || { echo "error: closure needs a glibc newer than ${maxGlibc}" >&2; exit 1; }
  echo "max GLIBC version referenced: $(cut -d' ' -f1 $TMPDIR/versions | sort -uV | tail -n1) ($(wc -l < $TMPDIR/versions) DSOs)"
  # (outside usr/: root.nix copies only usr/ and etc/ of FHS trees)
  mkdir -p $out/nix-support
  sort -V $TMPDIR/versions > $out/nix-support/glibc-versions.txt
  (cd $out && find usr \( -type f -o -type l \) | sort) > $out/nix-support/files
''
