#!/bin/sh
# rpm's check-files, aware of the BUILDROOT/usr -> <prefix> symlink: files that
# %files names as /usr/X are the files on disk at <prefix>/X.
RPM_BUILD_ROOT="${1}"; P="${NIX_RPM_PREFIX:?}"
[ -d "${RPM_BUILD_ROOT}" ] || { cat > /dev/null; exit 1; }
FILES_DISK=`mktemp "${TMPDIR:-/tmp}/rpmXXXXXX"`
trap "rm -f \"${FILES_DISK}\"" 0 2 3 5 10 13 15
find "${RPM_BUILD_ROOT}" -type f -o -type l | grep -vx "${RPM_BUILD_ROOT}/usr" | LC_ALL=C sort > "${FILES_DISK}"
sed -e "s!^${RPM_BUILD_ROOT}/usr/!${RPM_BUILD_ROOT}${P}/!" | LC_ALL=C sort -u | diff -d "${FILES_DISK}" - | sed -n 's!^\(-\|< \)'"${RPM_BUILD_ROOT}"'\(.*\)$!   \2!gp'
