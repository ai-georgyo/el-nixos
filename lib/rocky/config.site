# el-nixos CONFIG_SITE for relocated builds (docs/nix-native-design.md §1.3):
# give store prefixes the defaults distros give prefix=/usr (what Fedora's
# /usr/share/config.site does for /usr).  Sourced by every autoconf configure;
# per-package fragments (e.g. packages/glibc/glibc.site) follow in the same
# CONFIG_SITE list and may use $el_nixos_lib.
#
# Host-aware: glibc (and every multilib spec) configures i686 and x86_64 in one
# %build.  sysconfdir/localstatedir/... are autoconf variables, not cache
# variables, and are only changed while they still have autoconf's defaults
# (an explicit --sysconfdir=... from %configure or the spec wins).
case "$prefix" in /nix/store/*)
  case "${host_alias:-${build_alias:-x86_64}}" in
    x86_64*|aarch64*|ppc64*|s390x*) el_nixos_lib=lib64 ;;
    *) el_nixos_lib=lib ;;
  esac
  test "$libdir"         = '${exec_prefix}/lib'   && libdir='${exec_prefix}/'$el_nixos_lib
  test "$sysconfdir"     = '${prefix}/etc'        && sysconfdir=/etc
  test "$localstatedir"  = '${prefix}/var'        && localstatedir=/var
  test "$sharedstatedir" = '${prefix}/com'        && sharedstatedir=/var/lib
  test "$runstatedir"    = '${localstatedir}/run' && runstatedir=/run
  ;;
esac
# autoconf >= 2.70 refuses a site script whose exit status is not 0 ("failed
# to load site script"); the last `test ... && ...` above is false whenever
# runstatedir was set explicitly (E2, E3: which, xz, expat, libxcrypt, krb5)
true
