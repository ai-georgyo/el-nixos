# Rocky stdenv config.site (sourced by every autoconf configure via CONFIG_SITE):
# relocated store prefix, FHS runtime state, multilib libdir -- what Fedora's
# /usr/share/config.site does for prefix=/usr.
case "$prefix" in /nix/store/*)
  case "${host_alias:-${build_alias:-x86_64}}" in
    x86_64*|aarch64*|ppc64*|s390x*) test "$libdir" = '${exec_prefix}/lib' && libdir='${exec_prefix}/lib64' ;;
  esac
  test "$sysconfdir" = '${prefix}/etc' && sysconfdir=/etc
  test "$localstatedir" = '${prefix}/var' && localstatedir=/var
  test "$sharedstatedir" = '${prefix}/com' && sharedstatedir=/var/lib
  ;;
esac
# E2 finding: autoconf >= 2.70 fails with "failed to load site script" when the
# script's last status is non-zero (here: a `test` above that did not match,
# e.g. which's configure with --sharedstatedir=/var/lib)
:
