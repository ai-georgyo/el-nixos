# CONFIG_SITE fragment for glibc (design §1.3), sourced after the generic
# lib/rocky/config.site by both configure runs of %build (x86_64 and the
# i686 glibc32 build).  For --prefix=/usr, sysdeps/gnu/configure and
# sysdeps/unix/sysv/linux/x86_64/64/configure put the loader and the shared
# libraries in /lib64 (/lib), locales in /usr/lib/locale and ldconfig in /sbin;
# for a store prefix they would fall back to Makeconfig's defaults
# (slibdir=$prefix/lib, complocaledir=$libdir/locale).  Same layout below
# the store prefix, so the usrmerge folding gives Rocky's relative paths:
#   x86_64: $prefix/lib64/{ld-linux-x86-64.so.2,libc.so.6,...}
#   i686:   $prefix/lib/{ld-linux.so.2,libc.so.6,...}
#   both:   $prefix/lib/locale, $prefix/sbin/ldconfig
case "$prefix" in /nix/store/*)
  # el_nixos_lib comes from the generic config.site; standalone fallback
  if test -z "$el_nixos_lib"; then
    case "${host_alias:-${build_alias:-x86_64}}" in
      x86_64*|aarch64*|ppc64*|s390x*) el_nixos_lib=lib64 ;;
      *) el_nixos_lib=lib ;;
    esac
  fi
  libc_cv_slibdir=$prefix/$el_nixos_lib
  libc_cv_rtlddir=$prefix/$el_nixos_lib
  libc_cv_complocaledir=$prefix/lib/locale
  libc_cv_rootsbindir=$prefix/sbin
  ;;
esac
